# ==============================================================================
# FLOOD EVACUATION ROUTE PLANNER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Maps JavaScript API Key (Used strictly for client-side map rendering)
# If left empty, application displays a key setup prompt or continues in local canvas visualizer mode
GOOGLE_MAPS_API_KEY=""

# Municipal Region
CITY="Pimpri-Chinchwad (PCMC), Pune"
CITY_LAT=18.6274
CITY_LNG=73.8016

# Telemetry Polling Interval in seconds (default: 30 for demo, 120 for production)
POLL_INTERVAL=30

# Demo Mode: Set to true to automatically cycle through simulated monsoon rainfall surges
DEMO_MODE=true

# Notification Channel for NGO Dispatch Alerts
# Options: DEMO (default, in-memory log), EMAIL (SMTP), TELEGRAM (Bot API)
NOTIFY_CHANNEL=DEMO

# Recipient Email for Field Operations (Used when NOTIFY_CHANNEL=EMAIL)
NOTIFICATION_EMAIL=emergency-ops@pcmcindia.gov.in

# SMTP Configuration (Optional, required only if NOTIFY_CHANNEL=EMAIL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telegram Bot Alert Configuration (Optional, required only if NOTIFY_CHANNEL=TELEGRAM)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Base URL for NGO field dispatch routes and acknowledgment callbacks
APP_URL=http://localhost:8000
